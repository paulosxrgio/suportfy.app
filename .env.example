# Copie para .env.local (nunca versionado) e preencha. Nenhuma variável aqui
# usa NEXT_PUBLIC_: nada disto chega ao navegador.

# Sem DATABASE_URL a aplicação roda em modo demonstração (dados fictícios em memória).
# Postgres 15+ (Supabase, Neon, RDS ou local). O usuário precisa poder criar papéis
# na primeira migration (CREATE ROLE suportfy_app).
DATABASE_URL=

# Chave AES-256 para cifrar segredos das organizações (32 bytes em base64).
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
SUPORTFY_ENCRYPTION_KEY=
SUPORTFY_ENCRYPTION_KEY_VERSION=1

# Só para testes de integração: banco onde o Vitest cria e apaga bancos temporários.
TEST_DATABASE_URL=
